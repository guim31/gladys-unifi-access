{
  "manifest_version": 1,
  "type": "device",
  "name": "UniFi Access",
  "description": {
    "en": "UniFi Access doors: lock, door sensor, doorbell, granted or denied accesses and door alarms.",
    "fr": "Portes UniFi Access : verrou, capteur d'ouverture, sonnette, accès autorisés ou refusés, alarmes.",
    "de": "UniFi-Access-Türen: Schloss, Türsensor, Klingel, erlaubte oder verweigerte Zutritte, Alarme.",
    "es": "Puertas UniFi Access: cerradura, sensor, timbre, accesos permitidos o denegados y alarmas."
  },
  "version": "1.0.1",
  "docker_image": "ghcr.io/guim31/gladys-unifi-access:1.0.1",
  "gladys_version": ">=5.1.0",
  "cover_image": "https://raw.githubusercontent.com/guim31/gladys-unifi-access/main/cover.png",
  "categories": ["security"],
  "transports": ["local"],
  "config_schema": [
    {
      "key": "intro",
      "type": "section",
      "label": {
        "en": "Your UniFi console",
        "fr": "Votre console UniFi",
        "de": "Deine UniFi-Konsole",
        "es": "Su consola UniFi"
      },
      "description": {
        "en": "UniFi Access on a UniFi OS console (UDM, UCG, UNVR, Cloud Key…). In UniFi Access, create an API token: Settings, General, Advanced, API Token, with the Space and Device permissions.",
        "fr": "UniFi Access sur une console UniFi OS (UDM, UCG, UNVR, Cloud Key…). Dans UniFi Access, créez un jeton d'API : Settings, General, Advanced, API Token, avec les permissions Space et Device.",
        "de": "UniFi Access auf einer UniFi-OS-Konsole (UDM, UCG, UNVR, Cloud Key…). Erstelle in UniFi Access ein API-Token: Settings, General, Advanced, API Token, mit den Rechten Space und Device.",
        "es": "UniFi Access en una consola UniFi OS (UDM, UCG, UNVR, Cloud Key…). En UniFi Access, cree un token de API: Settings, General, Advanced, API Token, con los permisos Space y Device."
      }
    },
    {
      "key": "host",
      "type": "string",
      "label": {
        "en": "Console address",
        "fr": "Adresse de la console",
        "de": "Adresse der Konsole",
        "es": "Dirección de la consola"
      },
      "description": {
        "en": "IP address or name of the console. The API answers on port 12445: add :port only if yours differs.",
        "fr": "Adresse IP ou nom de la console. L'API répond sur le port 12445 : ajoutez :port seulement s'il diffère.",
        "de": "IP-Adresse oder Name der Konsole. Die API antwortet auf Port 12445: Gib :Port nur an, wenn er abweicht.",
        "es": "Dirección IP o nombre de la consola. La API responde en el puerto 12445: añada :puerto solo si es otro."
      },
      "placeholder": {
        "en": "e.g. 192.168.1.1",
        "fr": "ex. 192.168.1.1",
        "de": "z. B. 192.168.1.1",
        "es": "p. ej. 192.168.1.1"
      },
      "required": true,
      "default": ""
    },
    {
      "key": "api_token",
      "type": "secret",
      "label": {
        "en": "API token",
        "fr": "Jeton d'API",
        "de": "API-Token",
        "es": "Token de API"
      },
      "description": {
        "en": "Created in UniFi Access, shown once. Kept in Gladys, never written in the logs.",
        "fr": "Créé dans UniFi Access, affiché une seule fois. Gardé dans Gladys, jamais écrit dans les logs.",
        "de": "In UniFi Access erstellt, nur einmal angezeigt. In Gladys gespeichert, nie in den Protokollen.",
        "es": "Creado en UniFi Access, se muestra una sola vez. Guardado en Gladys, nunca en los registros."
      },
      "required": true
    },
    {
      "key": "allow_self_signed",
      "type": "boolean",
      "label": {
        "en": "Accept the self-signed certificate",
        "fr": "Accepter le certificat auto-signé",
        "de": "Selbstsigniertes Zertifikat akzeptieren",
        "es": "Aceptar el certificado autofirmado"
      },
      "description": {
        "en": "UniFi consoles serve a self-signed certificate on port 12445: tick it unless you installed a trusted one.",
        "fr": "Les consoles UniFi servent un certificat auto-signé sur le port 12445 : à cocher, sauf si vous en avez installé un reconnu.",
        "de": "UniFi-Konsolen liefern auf Port 12445 ein selbstsigniertes Zertifikat: Aktiviere das, außer du hast ein vertrauenswürdiges installiert.",
        "es": "Las consolas UniFi sirven un certificado autofirmado en el puerto 12445: márquelo salvo que haya instalado uno reconocido."
      },
      "required": false,
      "default": false
    },
    {
      "key": "safety",
      "type": "section",
      "label": {
        "en": "Remote unlock",
        "fr": "Déverrouillage à distance",
        "de": "Fernentriegelung",
        "es": "Desbloqueo remoto"
      },
      "description": {
        "en": "Off by default. Enabled, it allows the scene action \"Unlock a door\" and ending \"always locked\" — never a switch nor a dashboard button. A scene that misfires then opens your door: enable it knowingly.",
        "fr": "Désactivé par défaut. Activé, il permet l'action de scène « Déverrouiller une porte » et la sortie de « toujours verrouillée » — jamais un interrupteur ni un bouton. Une scène qui se trompe ouvre alors votre porte : activez-le en connaissance de cause.",
        "de": "Standardmäßig aus. Aktiviert erlaubt sie die Szenen-Aktion „Eine Tür entriegeln“ und das Beenden von „immer verriegelt“ — nie als Schalter oder Taste. Eine fehlerhafte Szene öffnet dann deine Tür: Aktiviere sie bewusst.",
        "es": "Desactivado por defecto. Activado, permite la acción de escena «Desbloquear una puerta» y salir de «siempre bloqueada», nunca un interruptor ni un botón. Una escena errónea abre entonces su puerta: actívelo con conocimiento de causa."
      }
    },
    {
      "key": "allow_remote_unlock",
      "type": "boolean",
      "label": {
        "en": "Allow remote unlock from scenes",
        "fr": "Autoriser le déverrouillage par les scènes",
        "de": "Fernentriegelung durch Szenen erlauben",
        "es": "Permitir el desbloqueo desde escenas"
      },
      "description": {
        "en": "Each unlock is signed \"Gladys\" in the UniFi Access system log.",
        "fr": "Chaque déverrouillage est signé « Gladys » dans le journal système d'UniFi Access.",
        "de": "Jede Entriegelung erscheint als „Gladys“ im Systemprotokoll von UniFi Access.",
        "es": "Cada desbloqueo aparece firmado «Gladys» en el registro del sistema de UniFi Access."
      },
      "required": false,
      "default": false
    },
    {
      "key": "language",
      "type": "select",
      "label": {
        "en": "Language of the feature names",
        "fr": "Langue des noms de fonctionnalités",
        "de": "Sprache der Funktionsnamen",
        "es": "Idioma de los nombres de funciones"
      },
      "description": {
        "en": "Names given to the features when a door is added, and texts of the states and scene events.",
        "fr": "Noms donnés aux fonctionnalités à l'ajout d'une porte, et textes des états et des événements de scène.",
        "de": "Namen der Funktionen beim Hinzufügen einer Tür und Texte der Zustände und Szenen-Ereignisse.",
        "es": "Nombres de las funciones al añadir una puerta y textos de los estados y eventos de escena."
      },
      "required": false,
      "default": "fr",
      "options": [
        {
          "value": "en",
          "label": {
            "en": "English",
            "fr": "Anglais",
            "de": "Englisch",
            "es": "Inglés"
          }
        },
        {
          "value": "fr",
          "label": {
            "en": "French",
            "fr": "Français",
            "de": "Französisch",
            "es": "Francés"
          }
        },
        {
          "value": "de",
          "label": {
            "en": "German",
            "fr": "Allemand",
            "de": "Deutsch",
            "es": "Alemán"
          }
        },
        {
          "value": "es",
          "label": {
            "en": "Spanish",
            "fr": "Espagnol",
            "de": "Spanisch",
            "es": "Español"
          }
        }
      ]
    }
  ],
  "actions": [
    {
      "key": "test_connection",
      "label": {
        "en": "Test the connection",
        "fr": "Tester la connexion",
        "de": "Verbindung testen",
        "es": "Probar la conexión"
      },
      "description": {
        "en": "Reads the console now and reports the doors, devices and notifications.",
        "fr": "Lit la console maintenant et indique les portes, appareils et notifications.",
        "de": "Liest die Konsole sofort und meldet Türen, Geräte und Benachrichtigungen.",
        "es": "Lee la consola ahora e indica las puertas, los dispositivos y las notificaciones."
      },
      "timeout_seconds": 30
    }
  ],
  "scene_triggers": [
    {
      "key": "doorbell_rang",
